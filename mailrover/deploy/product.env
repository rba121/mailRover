START_ROVER=/home/mypi/mailrover/deploy/start_rover_managed.sh
START_MOTOR=/home/mypi/mailrover/deploy/start_motor_managed.sh

MAP_FILE=/home/mypi/maps/test.yaml
NAV_PARAMS=/home/mypi/ros2_ws_simon/nav2_params.yaml

SCAN_TIMEOUT=120
ODOM_TIMEOUT=120
FILTERED_SCAN_TIMEOUT=120
MAP_TIMEOUT=180
NAVIGATION_TIMEOUT=180
BRIDGE_TIMEOUT=60
APP_TIMEOUT=60

# Runtime health watchdog
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=30
WATCHDOG_TIMEOUT=10

# Safe only when every cold boot begins with the robot physically at Home.
# The startup script publishes this pose at most once per Pi boot.
AUTO_INITIAL_POSE=true

# Home/loading-bay pose from /home/mypi/scripts/rooms.yaml.
DOCK_X=24.15984153883082
DOCK_Y=-45.741435235488034
DOCK_YAW=0.486
