import os
import queue
import shutil
import subprocess
import threading


class VoiceService:
    """Non-blocking, deduplicated Piper announcements."""

    PHRASES = {
        "DISPATCHED": "Delivery started. Please stand clear.",
        "ARRIVED": (
            "Hello. I am Mail Rover. I have arrived with your delivery. "
            "Please check your email for access instructions."
        ),
        "UNLOCKED": (
            "Access approved. The drawer is unlocking. "
            "Please retrieve your package."
        ),
        "ASSISTANCE": (
            "I need assistance. Please contact the Mail Rover administrator."
        ),
    }

    def __init__(self, logger):
        self.logger = logger
        self.enabled = self._env_bool("VOICE_ENABLED", False)
        self.piper_bin = self._resolve_command(
            os.environ.get("PIPER_BIN", "piper")
        )
        self.model = os.environ.get("PIPER_MODEL", "").strip()
        self.aplay_bin = self._resolve_command(
            os.environ.get("APLAY_BIN", "/usr/bin/aplay")
        )
        self.alsa_device = os.environ.get(
            "VOICE_ALSA_DEVICE",
            "plughw:0,0",
        ).strip()
        self.sample_rate = os.environ.get(
            "VOICE_SAMPLE_RATE",
            "22050",
        ).strip()
        self.volume = os.environ.get("VOICE_VOLUME", "20").strip()
        self.timeout_seconds = max(
            5,
            int(os.environ.get("VOICE_TIMEOUT_SECONDS", "30")),
        )

        self._queue = queue.Queue(maxsize=20)
        self._dedupe_lock = threading.Lock()
        self._queued_or_spoken = set()
        self.ready = self._validate_configuration()

        if self.ready:
            self._worker_thread = threading.Thread(
                target=self._worker,
                name="mailrover-voice",
                daemon=True,
            )
            self._worker_thread.start()
            self.logger.log(
                "VOICE_READY",
                (
                    f"model={self.model} "
                    f"device={self.alsa_device} "
                    f"sample_rate={self.sample_rate}"
                ),
            )

    @staticmethod
    def _env_bool(name: str, default: bool) -> bool:
        value = os.environ.get(name)
        if value is None:
            return default
        return value.strip().lower() in ("1", "true", "yes", "on")

    @staticmethod
    def _resolve_command(command: str):
        command = (command or "").strip()
        if not command:
            return None
        if os.path.isabs(command):
            return command if os.path.isfile(command) else None
        return shutil.which(command)

    def _validate_configuration(self) -> bool:
        if not self.enabled:
            self.logger.log("VOICE_DISABLED", "VOICE_ENABLED is false")
            return False

        problems = []
        if not self.piper_bin:
            problems.append("PIPER_BIN not found")
        if not self.model or not os.path.isfile(self.model):
            problems.append("PIPER_MODEL not found")
        if not self.aplay_bin:
            problems.append("aplay not found")

        if problems:
            self.logger.log("VOICE_CONFIG_INVALID", "; ".join(problems))
            return False
        return True

    def announce(self, event: str, task_id: str = "") -> bool:
        event = (event or "").strip().upper()
        phrase = self.PHRASES.get(event)
        if not self.ready or not phrase:
            return False

        announcement_key = f"{task_id or 'GLOBAL'}:{event}"
        with self._dedupe_lock:
            if announcement_key in self._queued_or_spoken:
                return False
            self._queued_or_spoken.add(announcement_key)

        try:
            self._queue.put_nowait((announcement_key, event, phrase))
            self.logger.log(
                "VOICE_QUEUED",
                f"event={event} task={task_id or '-'}",
            )
            return True
        except queue.Full:
            with self._dedupe_lock:
                self._queued_or_spoken.discard(announcement_key)
            self.logger.log(
                "VOICE_QUEUE_FULL",
                f"event={event} task={task_id or '-'}",
            )
            return False

    def _worker(self):
        while True:
            announcement_key, event, phrase = self._queue.get()
            try:
                self._speak(phrase)
                self.logger.log(
                    "VOICE_SPOKEN",
                    f"event={event} key={announcement_key}",
                )
            except Exception as error:
                self.logger.log(
                    "VOICE_PLAY_FAIL",
                    f"event={event} err={error}",
                )
            finally:
                self._queue.task_done()

    def _speak(self, phrase: str):
        piper_command = [
            self.piper_bin,
            "--model",
            self.model,
        ]
        if self.volume:
            piper_command.extend(["--volume", self.volume])
        piper_command.append("--output_raw")

        generated = subprocess.run(
            piper_command,
            input=(phrase + "\n").encode("utf-8"),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=self.timeout_seconds,
            check=False,
        )
        if generated.returncode != 0:
            error_text = generated.stderr.decode("utf-8", errors="replace")[-500:]
            raise RuntimeError(
                f"piper exited {generated.returncode}: {error_text}"
            )

        played = subprocess.run(
            [
                self.aplay_bin,
                "-D",
                self.alsa_device,
                "-r",
                self.sample_rate,
                "-f",
                "S16_LE",
                "-t",
                "raw",
                "-",
            ],
            input=generated.stdout,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            timeout=self.timeout_seconds,
            check=False,
        )
        if played.returncode != 0:
            error_text = played.stderr.decode("utf-8", errors="replace")[-500:]
            raise RuntimeError(
                f"aplay exited {played.returncode}: {error_text}"
            )
