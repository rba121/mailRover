MAILROVER_HOST=0.0.0.0
MAILROVER_PORT=8000
PUBLIC_BASE_URL=http://172.16.133.181:8000
USE_REAL_GPIO_ACTUATORS=true
GPIO_CHIP_PATH=/dev/gpiochip4
D1_UNLOCK_GPIO=26
D1_LOCK_STATE_GPIO=16
POWER_BUTTON_GPIO=10
POWER_BUTTON_ACTIVE_LOW=false
SOLENOID_UNLOCK_ACTIVE_LOW=false
LOCK_STATE_LOCKED_HIGH=true
LOCK_FEEDBACK_REQUIRED=true
CANCEL_CUTOFF_HOURS=6
ENFORCE_DELIVERY_WINDOW=false
DISPATCH_LEAD_MINUTES=15
NAV_BRIDGE_ENABLED=false
NAV_BRIDGE_URL=http://127.0.0.1:8765/task
NAV_BRIDGE_TIMEOUT_SEC=2
EMAIL_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=replace_with_your_resend_api_key
SMTP_USE_TLS=true
EMAIL_FROM="MailRover <your-verified-email@yourdomain.com>"
MAILROVER_SALT=replace_with_a_long_random_secret
ADMIN_PASSWORD=replace_with_a_private_dispatcher_password
SERVICE_KEY=replace_with_a_long_random_service_key
