            logger.log("IDLE_LOCK_SAFE", "all mapped drawer solenoid GPIO lines set low")
        except Exception as e:
            logger.log("IDLE_LOCK_SAFE_FAIL", f"err={e}")


def handle_uart_message(msg: dict):
    """
    Handles incoming UART messages from Raspberry Pi ROS side.
    Expected format:
      STATUS|<task_id>|MOVING
      STATUS|<task_id>|ARRIVED
      STATUS|<task_id>|FAULT
      STATUS|<task_id>|BLOCKED
      STATUS|<task_id>|CANCELED
      STATUS|<task_id>|IDLE
    """
    with STATE_LOCK:
        if msg.get("type") == "LOCK":
            task_id = msg.get("task_id")
            lock_state = msg.get("lock_state", "").upper()

            STATE.last_nav_msg_time = now()

            if not STATE.active_task_id or task_id != STATE.active_task_id:
                logger.log("UART_LOCK_IGNORED", f"stale_or_unknown task={task_id} state={lock_state}")
                return

            handle_lock_state(lock_state)
            return

        if msg.get("type") != "STATUS":
            return

        task_id = msg.get("task_id")
        status = msg.get("status", "").upper()
        try:
            recovery_count = int(
                msg.get(
                    "recovery_count",
                    STATE.route_recovery_count,
                )
            )
        except (TypeError, ValueError):
            recovery_count = STATE.route_recovery_count

        try:
            recovery_limit = int(
                msg.get(
                    "recovery_limit",
                    STATE.recovery_limit,
                )
            )
        except (TypeError, ValueError):
            recovery_limit = STATE.recovery_limit

        STATE.route_recovery_count = recovery_count
        STATE.recovery_limit = recovery_limit

        STATE.last_nav_msg_time = now()
        STATE.nav_status = status

        if not STATE.active_task_id or task_id != STATE.active_task_id:
            logger.log("UART_IGNORED", f"stale_or_unknown task={task_id} status={status}")
            return

        if status in ["LOCKED", "LOCK_LOCKED"]:
            handle_lock_state("LOCKED")
            return

        if status in ["UNLOCKED", "LOCK_UNLOCKED"]:
            handle_lock_state("UNLOCKED")
            return

        if status == "MOVING":
            motion.moving = True
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "TASK_ACTIVE"
            STATE.reroute_status = "IDLE"
            update_active_package_status("DISPATCHED")
            STATE.drawer_prompt = (
                "Robot moving to delivery destination."
            )

        elif status == "RETRYING":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            # The delivery remains active. The bridge is resending
            # the same destination to Nav2.
            STATE.task_state = "TASK_ACTIVE"
            STATE.reroute_status = "RETRYING"
            if "recovery_count" not in msg:
                STATE.route_recovery_count += 1
            STATE.last_obstacle_event = (
                "Navigation goal aborted. "
                "Automatically retrying the same destination."
            )
            STATE.drawer_prompt = (
                "Navigation was interrupted. "
                "MailRover is retrying the destination automatically."
            )

        elif status == "ARRIVED":
            motion.moving = False
            motion.arrived = True
            motion.fault = False

            STATE.task_state = "ARRIVED_AUTH_REQUIRED"
            STATE.auth_required = True
            update_active_package_status("ARRIVED")
            voice.announce("ARRIVED", STATE.active_task_id)

            send_unlock_email()

            STATE.drawer_prompt = (
                "Arrived. Unlock code sent to recipient email."
            )

        elif status in ["RETURNING", "RETURN_RECOVERING"]:
            motion.moving = True
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "RETURNING_TO_LOADING"
            STATE.auth_required = False
            STATE.auth_ok = False
            update_active_package_status("RETURNING")

            if status == "RETURN_RECOVERING":
                STATE.drawer_prompt = (
                    "Return recovery in progress: "
                    f"{STATE.route_recovery_count}/"
                    f"{STATE.recovery_limit}"
                )
            else:
                STATE.drawer_prompt = (
                    "Robot returning Home to the loading bay."
                )

        elif status == "RETURNED":
            motion.moving = False
            motion.arrived = True
            motion.fault = False
            update_active_package_status("COMPLETED")

            logger.log(
                "RETURN_TO_LOADING_COMPLETE",
                f"task={STATE.active_task_id}",
            )

            reset_to_idle_after_complete(
                "Robot returned to loading bay. Ready for loading."
            )

        elif status == "RECOVERING":
            motion.moving = True
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "RECOVERING"
            STATE.drawer_prompt = (
                "Navigation recovery in progress: "
                f"{STATE.route_recovery_count}/"
                f"{STATE.recovery_limit}"
            )

        elif status == "ABORTING":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "ABORTING"
            STATE.drawer_prompt = (
                "Recovery limit reached. "
                "Stopping the robot."
            )

        elif status == "ABORTED":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "ABORTED_WAITING_OPERATOR"
            STATE.abort_reason = (
                msg.get("reason")
                or "RECOVERY_LIMIT"
            )
            STATE.abort_x = msg.get("x")
            STATE.abort_y = msg.get("y")
            STATE.abort_yaw = msg.get("yaw")
            STATE.abort_notification = True
            voice.announce("ASSISTANCE", STATE.active_task_id)

            STATE.drawer_prompt = (
                "Delivery aborted after "
                f"{STATE.route_recovery_count}/"
                f"{STATE.recovery_limit} recoveries. "
                "Waiting for administrator."
            )

            if STATE.drawer_id in config.DRAWER_IDS:
                gpio.lock_drawer(STATE.drawer_id)

            if STATE.package_request_id in PACKAGE_REQUESTS:
                package = PACKAGE_REQUESTS[
                    STATE.package_request_id
                ]
                package.status = "ABORTED"
                save_package_request(package)

            logger.log(
                "DELIVERY_ABORTED",
                (
                    f"task={STATE.active_task_id} "
                    f"recoveries={STATE.route_recovery_count}/"
                    f"{STATE.recovery_limit} "
                    f"x={STATE.abort_x} "
                    f"y={STATE.abort_y} "
                    f"yaw={STATE.abort_yaw}"
                )
            )

        elif status == "RETURN_ABORTING":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "RETURN_ABORTING"
            STATE.drawer_prompt = (
                "Return recovery limit reached. "
                "Stopping the robot."
            )

        elif status == "RETURN_ABORTED":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "RETURN_ABORTED"
            STATE.abort_reason = (
                msg.get("reason")
                or "RETURN_FAILED"
            )
            STATE.abort_x = msg.get("x")
            STATE.abort_y = msg.get("y")
            STATE.abort_yaw = msg.get("yaw")
            STATE.abort_notification = True
            update_active_package_status("ABORTED")
            voice.announce("ASSISTANCE", STATE.active_task_id)

            STATE.drawer_prompt = (
                "Robot stopped after "
                f"{STATE.route_recovery_count}/"
                f"{STATE.recovery_limit} failed return attempts. "
                "It will not retry automatically. "
                "Manual assistance is required."
            )

        elif status == "FAULT":
            motion.moving = False
            motion.arrived = False
            motion.fault = True

            STATE.task_state = "FAULT"
            STATE.drawer_prompt = "Navigation fault active."
            voice.announce("ASSISTANCE", STATE.active_task_id)

        elif status == "BLOCKED":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            STATE.task_state = "BLOCKED"
            STATE.obstacle_status = "OBSTACLE_DETECTED"
            STATE.reroute_status = "REROUTING"
            STATE.last_obstacle_event = (
                "Obstacle detected. Replanning route."
            )
            STATE.drawer_prompt = (
                "Obstacle detected. Mail-Rover is calculating "
                "an alternate route."
            )

        elif status == "CANCELED":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            update_active_package_status("ABORTED")

            reset_to_idle_after_complete(
                "Task canceled by navigation system."
            )

        elif status == "IDLE":
            motion.moving = False
            motion.arrived = False
            motion.fault = False

            if STATE.active_task_id:
                update_active_package_status("ABORTED")

            reset_to_idle_after_complete()


def send_task_to_nav_bridge(
    task_id: str,
    destination: str,
    drawer_id: str,
    mission_type: str = "delivery",
) -> bool:
    if not getattr(config, "NAV_BRIDGE_ENABLED", False):
        return True

    payload = json.dumps({
        "task_id": task_id,
        "destination": destination,
        "drawer_id": drawer_id,
        "mission_type": mission_type,
    }).encode("utf-8")

    headers = {
        "Content-Type": "application/json",
        "X-MailRover-Service-Key": getattr(
            config,
            "SERVICE_KEY",
            "",
        ),
    }

    req = urllib.request.Request(
        getattr(
            config,
            "NAV_BRIDGE_URL",
            "http://127.0.0.1:8765/task",
        ),
        data=payload,
        headers=headers,
        method="POST",
    )

    try:
        with urllib.request.urlopen(
            req,
            timeout=getattr(
                config,
                "NAV_BRIDGE_TIMEOUT_SEC",
                2.0,
            ),
        ) as response:
            ok = 200 <= response.status < 300

            logger.log(
                "NAV_BRIDGE_TASK_SEND",
                (
                    f"task={task_id} "
                    f"destination={destination} "
                    f"mission_type={mission_type} "
                    f"ok={ok}"
                ),
            )

            return ok

    except Exception as e:
        logger.log(
            "NAV_BRIDGE_TASK_FAIL",
            (
                f"task={task_id} "
                f"destination={destination} "
                f"mission_type={mission_type} "
                f"err={e}"
            ),
        )
        return False

