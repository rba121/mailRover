@app.post("/auth/verify")
def auth_verify():
    with STATE_LOCK:
        t0 = time.time()
        mark_ui_contact()
        refresh_from_adapters()

        if in_lockout():
            logger.log("AUTH_BLOCKED", "lockout active")
            return jsonify({"ok": False, "error": "LOCKOUT_ACTIVE"}), 403

        if not STATE.comm_ok or not comm_is_fresh():
            logger.log("AUTH_BLOCKED", "comm_lost")
            return jsonify({"ok": False, "error": "COMM_LOST"}), 403

        if STATE.task_state != "ARRIVED_AUTH_REQUIRED":
            logger.log("AUTH_BLOCKED", f"invalid_state state={STATE.task_state}")
            return jsonify({"ok": False, "error": "INVALID_STATE", "state": STATE.task_state}), 403

        data = request.get_json(force=True)
        pin = (data.get("pin") or "").strip()

        if not pin:
            return jsonify({"ok": False, "error": "PIN_REQUIRED"}), 400

        pin_hash = hash_pin(pin)

        if pin_hash == STATE.task_pin_hash:
            STATE.auth_ok = True
            STATE.failed_attempts = 0
            logger.log("AUTH_SUCCESS", f"task={STATE.active_task_id} drawer={STATE.drawer_id}")

            auto_unlocked = try_auto_unlock_after_auth()

            latency_ms = int((time.time() - t0) * 1000)
            logger.log("API_LATENCY", f"endpoint=/auth/verify latency_ms={latency_ms}")

            return jsonify({"ok": True, "ack": "AUTH_OK", "auto_unlocked": auto_unlocked})

        STATE.failed_attempts += 1
        logger.log("AUTH_FAIL", f"attempts={STATE.failed_attempts} task={STATE.active_task_id}")

        if STATE.failed_attempts >= 3:
            STATE.lockout_until = now() + timedelta(seconds=config.LOCKOUT_SECONDS)
            logger.log("LOCKOUT_TRIGGERED", f"until={STATE.lockout_until.isoformat(timespec='seconds')}")

        latency_ms = int((time.time() - t0) * 1000)
        logger.log("API_LATENCY", f"endpoint=/auth/verify latency_ms={latency_ms}")

        return jsonify({
            "ok": False,
            "error": "INVALID_PIN",
            "attempts_remaining": max(0, 3 - STATE.failed_attempts)
        }), 403


@app.post("/drawer/unlock")
def drawer_unlock():
    with STATE_LOCK:
        t0 = time.time()
        mark_ui_contact()
        refresh_from_adapters()

        if STATE.task_state != "ARRIVED_AUTH_REQUIRED":
            return jsonify({"ok": False, "error": "INVALID_STATE", "state": STATE.task_state}), 403

        if in_lockout():
            return jsonify({"ok": False, "error": "LOCKOUT_ACTIVE"}), 403

        if not STATE.auth_ok:
            return jsonify({"ok": False, "error": "AUTH_REQUIRED"}), 403

        if STATE.fault or STATE.moving:
            return jsonify({"ok": False, "error": "BUSY_OR_FAULT"}), 403

        if not STATE.comm_ok or not comm_is_fresh():
            return jsonify({"ok": False, "error": "COMM_LOST"}), 403

        if getattr(config, "UART_ENABLED", False):
            if not (STATE.arrived or STATE.nav_status == "ARRIVED"):
                return jsonify({"ok": False, "error": "NOT_ARRIVED"}), 403

        gpio.unlock_drawer(STATE.drawer_id)
        STATE.unlock_pulse_sent = True
        STATE.lock_state = "UNLOCK_PULSE_SENT"
        STATE.lock_unlocked_confirmed = False
        logger.log("DRAWER_UNLOCKED", f"drawer={STATE.drawer_id} task={STATE.active_task_id}")
        voice.announce("UNLOCKED", STATE.active_task_id)
        if lock_feedback_required():
            STATE.task_state = "AWAITING_RELOCK"
            STATE.auth_required = False
            STATE.drawer_prompt = "Unlock pulse sent. Waiting for robot to confirm the lock is secure again."
        else:
            complete_delivery_after_unlock()

        latency_ms = int((time.time() - t0) * 1000)
        logger.log("API_LATENCY", f"endpoint=/drawer/unlock latency_ms={latency_ms}")

        return jsonify({"ok": True, "ack": "DRAWER_UNLOCKED"})


