def package_confirm_home_complete(request_id):
    """Close a stale Needs Attention record after a safe restart at Home."""
    blocked = require_admin_page()
    if blocked:
        return blocked

    with STATE_LOCK:
        req = PACKAGE_REQUESTS.get(request_id)
        if not req:
            return jsonify({
                "ok": False,
                "error": "REQUEST_NOT_FOUND",
            }), 404

        if STATE.active_task_id:
            return jsonify({
                "ok": False,
                "error": "TASK_ACTIVE",
            }), 400

        if req.status != "ABORTED":
            return jsonify({
                "ok": False,
                "error": "REQUEST_NOT_ABORTED",
