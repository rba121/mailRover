    except Exception as e:
        logger.log(
            "NAV_BRIDGE_CANCEL_RETURN_HOME_FAIL",
            f"task={task_id} drawer={drawer_id} err={e}",
        )
        return False

uart = None



def ensure_uart_started():
    global uart

    if not getattr(config, "UART_ENABLED", False):
        return None

    if uart is None:
        uart = UARTBridge(
            port=config.UART_PORT,
            baudrate=config.UART_BAUDRATE,
            on_message=handle_uart_message,
            logger=logger
        )
        uart.start()
        logger.log("UART_STARTED", "UART bridge started on task creation")

    return uart

def cancel_delivery_for_estop(task_id: str):
    """
    Stop navigation after the physical E-stop while preserving the task.
    After the E-stop is released, the administrator can command Return Home.
    """
    with STATE_LOCK:
        if STATE.active_task_id != task_id:
            return

        drawer_id = STATE.drawer_id
        package_request_id = STATE.package_request_id

        STATE.task_state = "E_STOPPED_AWAITING_OPERATOR"
        STATE.nav_status = "E_STOPPED"
        STATE.drawer_prompt = (
            "Emergency stop active. Release it only after the robot is safe, "
            "then select Cancel & Return Home."
        )

        motion.moving = False
        motion.arrived = False
        motion.fault = False

        if drawer_id in ["D1", "D2", "D3", "D4"]:
            try:
                gpio.lock_drawer(drawer_id)
                logger.log(
                    "ESTOP_LOCK_SAFE",
                    f"task={task_id} drawer={drawer_id}",
                )
            except Exception as e:
                logger.log(
                    "ESTOP_LOCK_FAIL",
                    (
                        f"task={task_id} "
                        f"drawer={drawer_id} "
                        f"err={e}"
                    ),
                )

        if package_request_id in PACKAGE_REQUESTS:
            package = PACKAGE_REQUESTS[
                package_request_id
            ]
            package.status = "ABORTED"
            save_package_request(package)

            logger.log(
                "ESTOP_PACKAGE_PAUSED",
                (
                    f"task={task_id} "
                    f"request={package_request_id}"
                ),
            )

        STATE.route_recovery_count = 0
        STATE.abort_reason = ""
        STATE.abort_notification = False

    # Keep retrying the Nav2 pause request until the bridge acknowledges it.
    with PENDING_NAV_CANCELS_LOCK:
        PENDING_NAV_CANCELS.add(task_id)

    nav_cancel_ok = False

    for _ in range(3):
        if send_pause_to_nav_bridge(
            task_id,
            "E_STOP",
        ):
            nav_cancel_ok = True
            break

        time.sleep(0.20)

    if nav_cancel_ok:
        with PENDING_NAV_CANCELS_LOCK:
            PENDING_NAV_CANCELS.discard(task_id)

    else:
        logger.log(
            "ESTOP_NAV_PAUSE_PENDING",
            f"task={task_id}",
        )

    if uart:
        try:
            uart.send_task_cancel(task_id)
        except Exception as e:
            logger.log(
                "ESTOP_UART_CANCEL_FAIL",
                f"task={task_id} err={e}",
            )

    logger.log(
        "ESTOP_DELIVERY_PAUSED",
        (
            f"task={task_id} "
            f"nav_cancel_ok={nav_cancel_ok}"
        ),
    )


def estop_monitor_loop():
    """
    Continuously watch the physical E-stop.

    An E-stop that is already pressed at startup simply prevents dispatch.
    During a delivery it pauses Nav2 and preserves Return Home as the only
    safe follow-up mission after the E-stop is released.
    """
    handled_task_id = None

    logger.log(
        "ESTOP_MONITOR_STARTED",
        (
            "Physical E-stop monitoring active. "
            "Startup E-stop does not create a popup."
        ),
    )

    while True:
        try:
            estop = estop_status()
            stopped = bool(estop.get("stopped"))

            with STATE_LOCK:
                active_task_id = STATE.active_task_id

            if (
                stopped
                and active_task_id
                and active_task_id != handled_task_id
            ):
                handled_task_id = active_task_id

                logger.log(
                    "ESTOP_ACTIVE_DELIVERY",
                    (
                        f"task={active_task_id} "
                        f"raw={estop.get('raw')}"
                    ),
                )

                cancel_delivery_for_estop(
                    active_task_id
                )

            if not stopped:
                handled_task_id = None

            # Continue pause attempts after release. The old delivery goal
            # must never resume; only an explicit Return Home may move it.
            with PENDING_NAV_CANCELS_LOCK:
                pending_task_ids = list(
                    PENDING_NAV_CANCELS
                )

            for pending_task_id in pending_task_ids:
                if send_pause_to_nav_bridge(
                    pending_task_id,
                    "E_STOP_RETRY",
                ):
                    with PENDING_NAV_CANCELS_LOCK:
                        PENDING_NAV_CANCELS.discard(
                            pending_task_id
                        )

                    logger.log(
                        "ESTOP_NAV_PAUSE_CONFIRMED",
                        f"task={pending_task_id}",
                    )

        except Exception as e:
            logger.log(
                "ESTOP_MONITOR_ERROR",
                f"err={e}",
            )

        time.sleep(
            ESTOP_MONITOR_INTERVAL_SECONDS
        )

def handle_lock_state(lock_state: str):
    if lock_state not in ["LOCKED", "UNLOCKED"]:
        logger.log("LOCK_STATE_IGNORED", f"state={lock_state}")
        return

    previous = STATE.lock_state
    STATE.lock_state = lock_state
    logger.log(
        "LOCK_STATE",
        f"task={STATE.active_task_id} state={lock_state} previous={previous}"
    )

    if lock_state == "UNLOCKED" and STATE.task_state == "AWAITING_RELOCK":
        STATE.lock_unlocked_confirmed = True
        STATE.drawer_prompt = "Drawer unlocked. Waiting for robot to confirm lock is secure again."
        return

    if (
        lock_state == "LOCKED"
        and STATE.task_state == "AWAITING_RELOCK"
        and STATE.unlock_pulse_sent
        and STATE.lock_unlocked_confirmed
    ):
        complete_delivery_after_unlock()

def complete_delivery_after_unlock():
    completed_task_id = STATE.active_task_id
    completed_drawer_id = STATE.drawer_id

    if uart and completed_task_id:
        sent = False

        for _ in range(3):
            sent = uart.send_delivery_complete(
                completed_task_id
            )

            if sent:
                break

            time.sleep(0.2)

        if sent:
            logger.log(
                "DELIVERY_COMPLETE_SENT",
                f"task={completed_task_id}",
            )
        else:
            logger.log(
                "DELIVERY_COMPLETE_FAIL",
                f"task={completed_task_id}",
            )
    else:
        logger.log(
            "DELIVERY_COMPLETE_LOCAL",
            f"task={completed_task_id}",
        )

    # Retrieval is complete, but the delivery stays active until the
    # navigation bridge confirms that the robot has returned Home.
    update_active_package_status("RETURNING")

    # Keep the task active while the robot returns.
    STATE.task_state = "RETURNING_TO_LOADING"
    STATE.nav_status = "RETURN_REQUESTED"
    STATE.drawer_prompt = (
        "Package retrieved. Robot returning to loading bay."
    )

    STATE.auth_required = False
    STATE.auth_ok = False
    STATE.moving = True
    STATE.arrived = False
    STATE.fault = False

    motion.moving = True
    motion.arrived = False
    motion.fault = False

    return_sent = send_task_to_nav_bridge(
        completed_task_id,
        "Home",
        completed_drawer_id,
        mission_type="return",
    )

    if not return_sent:
        STATE.task_state = "FAULT"
        STATE.nav_status = "RETURN_SEND_FAILED"
        STATE.drawer_prompt = (
            "Package retrieved, but the return-to-loading "
            "command failed."
        )

        motion.moving = False
        motion.fault = True

        logger.log(
            "RETURN_TO_LOADING_FAIL",
            f"task={completed_task_id}",
        )
        voice.announce("ASSISTANCE", completed_task_id)

        return

    logger.log(
        "RETURN_TO_LOADING_SENT",
        f"task={completed_task_id}",
    )

def try_auto_unlock_after_auth() -> bool:
    refresh_from_adapters()

    if STATE.task_state != "ARRIVED_AUTH_REQUIRED":
        return False

    if STATE.fault or STATE.moving:
        return False

    if not STATE.comm_ok or not comm_is_fresh():
        return False

    if getattr(config, "UART_ENABLED", False):
        if not (STATE.arrived or STATE.nav_status == "ARRIVED"):
            return False

    if in_lockout():
        return False

    if not STATE.auth_ok:
        return False

    if STATE.drawer_id not in ["D1", "D2", "D3", "D4"]:
        return False

    gpio.unlock_drawer(STATE.drawer_id)
    STATE.unlock_pulse_sent = True
    STATE.lock_state = "UNLOCK_PULSE_SENT"
    STATE.lock_unlocked_confirmed = False
    logger.log("AUTO_UNLOCK_GRANTED", f"task={STATE.active_task_id} drawer={STATE.drawer_id}")
    logger.log("DRAWER_UNLOCKED", f"drawer={STATE.drawer_id} task={STATE.active_task_id}")
    voice.announce("UNLOCKED", STATE.active_task_id)

    if lock_feedback_required():
        STATE.task_state = "AWAITING_RELOCK"
        STATE.auth_required = False
        STATE.drawer_prompt = "Unlock pulse sent. Waiting for robot to confirm the lock is secure again."
    else:
        complete_delivery_after_unlock()
    return True


