@app.post("/package/<request_id>/dispatch")
def package_dispatch(request_id):
    blocked = require_admin_page()
    if blocked:
        return blocked

    data = request.get_json(silent=True) or {}
    drawer = (data.get("drawer_id") or "D1").strip().upper()

    with STATE_LOCK:
        req = PACKAGE_REQUESTS.get(request_id)
        if not req:
            return jsonify({"ok": False, "error": "REQUEST_NOT_FOUND"}), 404

        can_dispatch, dispatch_reason = can_dispatch_request(req)
        if not can_dispatch:
            return jsonify({
                "ok": False,
                "error": dispatch_reason,
                "request": serialize_package_request(req),
            }), 400

        estop = estop_status()
        if estop.get("stopped"):
            logger.log("PACKAGE_DISPATCH_BLOCKED", f"request={req.request_id} estop=STOPPED raw={estop.get('raw')}")
            return jsonify({
                "ok": False,
                "error": "ESTOP_ACTIVE",
                "message": "Please turn the Etop off inorder to dispatch",
                "estop": estop,
                "request": serialize_package_request(req),
            }), 403

        payload, status_code = create_delivery_task(
            req.destination,
            drawer,
            req.recipient_name,
            req.recipient_email,
            package_request_id=req.request_id,
        )

        if payload.get("ok"):
            req.status = "DISPATCHED"
            req.dispatch_task_id = payload.get("task_id")
            req.dispatched_at = now()
            save_package_request(req)
            payload["request"] = serialize_package_request(req)

    return jsonify(payload), status_code

@app.post("/admin/delivery/return_to_loading")
def admin_return_to_loading():
    blocked = require_admin_page()
    if blocked:
        return blocked

    with STATE_LOCK:
        if STATE.task_state not in [
            "ABORTED_WAITING_OPERATOR",
            "RETURN_ABORTED",
        ]:
            return jsonify({
                "ok": False,
                "error": "DELIVERY_NOT_ABORTED",
            }), 400

        if not STATE.active_task_id:
            return jsonify({
                "ok": False,
                "error": "NO_ACTIVE_TASK",
            }), 400

        estop = estop_status()

        if estop.get("stopped"):
            return jsonify({
                "ok": False,
                "error": "ESTOP_ACTIVE",
            }), 403

        task_id = STATE.active_task_id
        drawer_id = STATE.drawer_id or "D1"

        STATE.task_state = (
            "RETURNING_TO_LOADING_BAY"
        )
        STATE.nav_status = "RETURNING"
        STATE.route_recovery_count = 0
        STATE.abort_notification = False
        STATE.drawer_prompt = (
            "Sending return-to-loading-bay goal."
        )
        update_active_package_status("RETURNING")

        sent = send_task_to_nav_bridge(
            task_id,
            "Home",
            drawer_id,
            mission_type="return",
        )

        if not sent:
            STATE.task_state = (
                "ABORTED_WAITING_OPERATOR"
            )
            STATE.nav_status = "ABORTED"
            STATE.abort_notification = True
            update_active_package_status("ABORTED")
            STATE.drawer_prompt = (
                "Could not send return command "
                "to navigation."
            )

            return jsonify({
                "ok": False,
                "error": "NAV_BRIDGE_SEND_FAILED",
            }), 500

        logger.log(
            "RETURN_TO_LOADING_REQUESTED",
            (
                f"task={task_id} "
                f"from_x={STATE.abort_x} "
                f"from_y={STATE.abort_y}"
            )
        )

        return jsonify({
            "ok": True,
            "ack": "RETURN_TO_LOADING_SENT",
            "task_id": task_id,
        })


@app.post("/admin/delivery/cancel_return_home")
def admin_delivery_cancel_return_home():
    blocked = require_admin_page()
    if blocked:
        return blocked

    with STATE_LOCK:
        if not STATE.active_task_id:
            return jsonify({
                "ok": False,
                "error": "NO_ACTIVE_TASK",
            }), 400

        if STATE.task_state not in ADMIN_RETURN_HOME_STATES:
            return jsonify({
                "ok": False,
                "error": "RETURN_HOME_NOT_AVAILABLE",
                "state": STATE.task_state,
            }), 400

        estop = estop_status()
        if estop.get("stopped"):
            return jsonify({
                "ok": False,
                "error": "ESTOP_ACTIVE",
            }), 403

        task_id = STATE.active_task_id
        drawer_id = STATE.drawer_id or "D1"
        previous_state = STATE.task_state
        previous_nav_status = STATE.nav_status
        previous_prompt = STATE.drawer_prompt
        package_request = PACKAGE_REQUESTS.get(STATE.package_request_id)
        previous_package_status = (
            package_request.status if package_request else None
        )

        if drawer_id in config.DRAWER_IDS:
            try:
                gpio.lock_drawer(drawer_id)
            except Exception as e:
                logger.log(
                    "ADMIN_RETURN_HOME_LOCK_FAIL",
                    f"task={task_id} drawer={drawer_id} err={e}",
                )

        STATE.task_state = "RETURNING_TO_LOADING"
        STATE.nav_status = "RETURN_REQUESTED"
        STATE.auth_required = False
        STATE.auth_ok = False
        STATE.drawer_prompt = (
            "Canceling the current navigation goal, then returning Home."
        )
        motion.moving = True
        motion.arrived = False
        motion.fault = False
        update_active_package_status("RETURNING")

    sent = send_cancel_and_return_home_to_nav_bridge(
        task_id,
        drawer_id,
    )

    if not sent:
        with STATE_LOCK:
            if (
                STATE.active_task_id == task_id
                and STATE.nav_status == "RETURN_REQUESTED"
            ):
                STATE.task_state = previous_state
                STATE.nav_status = previous_nav_status
                STATE.drawer_prompt = previous_prompt
                motion.moving = False

                if package_request and previous_package_status:
                    package_request.status = previous_package_status
                    save_package_request(package_request)

        return jsonify({
            "ok": False,
            "error": "RETURN_HOME_SEND_FAILED",
        }), 502

    logger.log(
        "ADMIN_CANCEL_RETURN_HOME_REQUESTED",
        f"task={task_id} drawer={drawer_id}",
    )
    return jsonify({
        "ok": True,
        "ack": "CANCEL_RETURN_HOME_REQUESTED",
        "task_id": task_id,
    }), 202


@app.post("/admin/delivery/confirm_home_complete")
def admin_delivery_confirm_home_complete():
    """Close a preserved task after physical Home has been confirmed."""
    blocked = require_admin_page()
    if blocked:
        return blocked

    with STATE_LOCK:
        if not STATE.active_task_id:
            return jsonify({
                "ok": False,
                "error": "NO_ACTIVE_TASK",
            }), 400

        if STATE.task_state not in ADMIN_CONFIRM_HOME_STATES:
            return jsonify({
                "ok": False,
                "error": "HOME_CONFIRM_NOT_AVAILABLE",
                "state": STATE.task_state,
            }), 400

        estop = estop_status()
        if not estop.get("stopped"):
            return jsonify({
                "ok": False,
                "error": "ESTOP_REQUIRED_FOR_HOME_CONFIRM",
            }), 403

        task_id = STATE.active_task_id
        drawer_id = STATE.drawer_id
        package_request_id = STATE.package_request_id
        previous_state = STATE.task_state
        previous_nav_status = STATE.nav_status
        previous_prompt = STATE.drawer_prompt

        if drawer_id in config.DRAWER_IDS:
            try:
                gpio.lock_drawer(drawer_id)
            except Exception as e:
                logger.log(
                    "ADMIN_CONFIRM_HOME_LOCK_FAIL",
                    f"task={task_id} drawer={drawer_id} err={e}",
                )

        STATE.task_state = "CONFIRMING_HOME_COMPLETE"
        STATE.nav_status = "CANCELING_STALE_NAVIGATION"
        STATE.drawer_prompt = (
            "Confirming Home and closing the completed delivery."
        )
        motion.moving = False
        motion.arrived = False
        motion.fault = False

    canceled = send_cancel_to_nav_bridge(
        task_id,
        "ADMIN_CONFIRMED_PHYSICAL_HOME",
    )

    if not canceled:
        with STATE_LOCK:
            if STATE.active_task_id == task_id:
                STATE.task_state = previous_state
                STATE.nav_status = previous_nav_status
                STATE.drawer_prompt = previous_prompt

        return jsonify({
            "ok": False,
            "error": "NAV_CANCEL_FAILED",
        }), 502

    with STATE_LOCK:
        package_request = PACKAGE_REQUESTS.get(package_request_id)
        if package_request:
            package_request.status = "COMPLETED"
            save_package_request(package_request)

        reset_to_idle_after_complete(
            "Administrator confirmed the robot is physically Home. "
            "Ready for the next package."
        )

    logger.log(
        "ADMIN_PHYSICAL_HOME_CONFIRMED",
        f"task={task_id} request={package_request_id}",
    )
    return jsonify({
        "ok": True,
        "ack": "HOME_CONFIRMED_TASK_COMPLETED",
        "task_id": task_id,
    })

@app.post("/task/cancel")
