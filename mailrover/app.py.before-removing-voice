def estop_status() -> dict:
    if not hasattr(gpio, "read_estop"):
        logger.log("ESTOP_READ_FALLBACK", "GPIOAdapter has no read_estop; treating E-stop as ready")
        return {
            "configured": False,
            "gpio": getattr(config, "ESTOP_GPIO", 18),
            "raw": None,
            "stopped": False,
            "state": "UNKNOWN",
        }

    try:
        return gpio.read_estop()
    except Exception as e:
        logger.log("ESTOP_READ_FAIL", f"err={e}")
        return {
            "configured": True,
            "gpio": getattr(config, "ESTOP_GPIO", 18),
            "raw": None,
            "stopped": False,
            "state": "UNKNOWN",
        }


