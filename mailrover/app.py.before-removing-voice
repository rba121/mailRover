@app.post("/request/<token>/schedule")
def request_delivery_schedule(token):
    data = request.form if request.form else request.get_json(force=True)
    selected_slot = (data.get("slot") or "").strip()

    if not selected_slot:
        return jsonify({"ok": False, "error": "TIME_SLOT_REQUIRED"}), 400

    with STATE_LOCK:
        req = find_package_request_by_token(token)
        if not req:
            abort(404)

        if req.status not in ["NOTIFIED", "SCHEDULED"]:
            return jsonify({"ok": False, "error": "REQUEST_NOT_SCHEDULABLE"}), 400

        slots = available_slots()
        if req.requested_slot and req.requested_slot not in slots:
            slots.append(req.requested_slot)

        if selected_slot not in slots:
            return jsonify({"ok": False, "error": "TIME_SLOT_UNAVAILABLE"}), 409

        req.requested_slot = selected_slot
        req.status = "SCHEDULED"
        req.scheduled_at = now()
        save_package_request(req)
        serialized = serialize_package_request(req)

    email_result = send_delivery_scheduled_email(req)
    logger.log(
        "PACKAGE_SCHEDULED",
        f"request={req.request_id} slot={req.requested_slot} destination={req.destination}"
    )

    if request.form:
        return render_template(
            "request_delivery.html",
            pkg=serialized,
            slots=available_slots(),
            scheduled=True,
            email=email_result,
        )

    return jsonify({"ok": True, "request": serialized, "email": email_result})


