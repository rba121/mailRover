def enter_safe_hold(reason: str):
    if STATE.task_state != "SAFE_HOLD":
        STATE.safe_hold_prev_state = STATE.task_state

    STATE.task_state = "SAFE_HOLD"
    STATE.drawer_prompt = f"Safe hold active: {reason}"

    motion.moving = False
    motion.arrived = False

    if STATE.drawer_id in ["D1", "D2", "D3", "D4"]:
        try:
            gpio.lock_drawer(STATE.drawer_id)
            logger.log("SAFE_HOLD_LOCK_SAFE", f"drawer={STATE.drawer_id}")
        except Exception as e:
            logger.log("SAFE_HOLD_LOCK_ERROR", f"drawer={STATE.drawer_id} err={e}")

    logger.log("SAFE_HOLD_ENTER", reason)


def on_comm_lost():
    with STATE_LOCK:
        STATE.comm_ok = False
        logger.log("COMM_LOST", f"UI polling timeout (>{config.COMM_TIMEOUT_SECONDS}s)")
        enter_safe_hold("UI communication lost")


def on_comm_restored():
    with STATE_LOCK:
        STATE.comm_ok = True
        logger.log("COMM_RESTORED", "UI polling resumed")

        if STATE.task_state != "SAFE_HOLD":
            return

        prev = STATE.safe_hold_prev_state

        if prev == "ARRIVED_AUTH_REQUIRED":
            STATE.task_state = "ARRIVED_AUTH_REQUIRED"
            STATE.drawer_prompt = "Communication restored. Enter PIN to unlock drawer."
        elif prev == "TASK_ACTIVE":
            STATE.task_state = "TASK_ACTIVE"
            STATE.drawer_prompt = "Communication restored. Task is active."
        else:
            STATE.task_state = "IDLE"
            STATE.drawer_prompt = "Ready for a new delivery task."

        STATE.safe_hold_prev_state = None


watchdog = CommWatchdog(
    config.COMM_TIMEOUT_SECONDS,
    on_comm_lost,
    on_comm_restored
)


def refresh_from_adapters():
    global BATTERY_LAST_PERSISTED_PERCENT
    global BATTERY_LAST_PERSISTED_VOLTAGE_MV
    global BATTERY_ADC_LAST_ERROR

    with BATTERY_STATE_LOCK:
        battery_reading = battery_adc.read()
        if battery_reading["ok"]:
            current_percent = battery_reading["percent"]
            current_voltage_mv = battery_reading["voltage_mv"]
            STATE.battery_percent = current_percent
            STATE.battery_voltage_mv = current_voltage_mv
            STATE.battery_adc_ok = True
            STATE.battery_reading_source = "ADC"

            if (
                current_percent != BATTERY_LAST_PERSISTED_PERCENT
                or BATTERY_LAST_PERSISTED_VOLTAGE_MV is None
                or abs(
                    current_voltage_mv
                    - BATTERY_LAST_PERSISTED_VOLTAGE_MV
                ) >= 64
            ):
                persist_battery_reading(
                    current_percent,
                    current_voltage_mv,
                )
                BATTERY_LAST_PERSISTED_PERCENT = current_percent
                BATTERY_LAST_PERSISTED_VOLTAGE_MV = current_voltage_mv

            if BATTERY_ADC_LAST_ERROR is not None:
                logger.log(
                    "BATTERY_ADC_RECOVERED",
                    (
                        f"percent={current_percent} "
                        f"voltage_mv={current_voltage_mv}"
                    ),
                )
                BATTERY_ADC_LAST_ERROR = None
        else:
            STATE.battery_adc_ok = False
            STATE.battery_reading_source = "SAVED"
            current_error = battery_reading["error"]
            if current_error != BATTERY_ADC_LAST_ERROR:
                logger.log("BATTERY_ADC_READ_FAIL", current_error)
                BATTERY_ADC_LAST_ERROR = current_error

    m = motion.get_state()
    STATE.moving = m["moving"]
    STATE.arrived = m["arrived"]
    STATE.fault = m["fault"]

    drawer_to_monitor = STATE.drawer_id
    if not drawer_to_monitor and config.DRAWER_IDS:
        drawer_to_monitor = config.DRAWER_IDS[0]

    if drawer_to_monitor:
        gpio_lock_state = gpio.read_lock_state(drawer_to_monitor)
        if gpio_lock_state in ["LOCKED", "UNLOCKED"]:
            handle_lock_state(gpio_lock_state)


