def send_cancel_and_return_home_to_nav_bridge(
    task_id: str,
    drawer_id: str,
) -> bool:
    """Atomically replace the active delivery goal with the Home goal."""
    if not getattr(config, "NAV_BRIDGE_ENABLED", False):
        if uart:
            return uart.send_return_home(task_id, drawer_id)

        logger.log(
            "NAV_RETURN_HOME_SIMULATED",
            f"task={task_id} drawer={drawer_id}",
        )
        return True

    task_url = getattr(
        config,
        "NAV_BRIDGE_URL",
        "http://127.0.0.1:8765/task",
    )
    return_home_url = task_url.rsplit("/", 1)[0] + "/return-home"
    payload = json.dumps({
        "task_id": task_id,
        "drawer_id": drawer_id,
