def service_key_configured() -> bool:
    return bool(getattr(config, "SERVICE_KEY", ""))


def request_service_key() -> str:
    return (
        request.headers.get("X-MailRover-Service-Key")
        or request.args.get("service_key")
        or ""
    )


def require_service_key():
    expected = getattr(config, "SERVICE_KEY", "")
    if not expected:
        logger.log("SERVICE_KEY_WARN", "SERVICE_KEY not configured; dev route allowed")
        return None

    provided = request_service_key()
    if hmac.compare_digest(provided, expected):
        return None

    logger.log("SERVICE_KEY_DENIED", f"path={request.path}")
    return jsonify({"ok": False, "error": "SERVICE_KEY_REQUIRED"}), 401


