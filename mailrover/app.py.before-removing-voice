@app.get("/status")
def status():
    with STATE_LOCK:
        t0 = time.time()

        mark_ui_contact()
        refresh_from_adapters()

        if getattr(config, "UART_ENABLED", False):
            if (
                STATE.active_task_id
                and STATE.last_nav_msg_time is not None
                and not STATE.arrived
                and not nav_is_fresh()
            ):
                enter_safe_hold("Navigation status stale")

        if battery_is_critical() and STATE.active_task_id:
            enter_safe_hold("Critical battery level")

        handle_ready_for_loading()
        payload = asdict(STATE)
        payload["lockout_until"] = STATE.lockout_until.isoformat(timespec="seconds") if STATE.lockout_until else None
        payload["last_ui_ping"] = STATE.last_ui_ping.isoformat(timespec="seconds") if STATE.last_ui_ping else None
        payload["last_nav_msg_time"] = STATE.last_nav_msg_time.isoformat(timespec="seconds") if STATE.last_nav_msg_time else None
        payload["low_battery_block_percent"] = config.LOW_BATTERY_BLOCK_PERCENT
        payload["critical_battery_percent"] = config.CRITICAL_BATTERY_PERCENT
        payload["lock_feedback_required"] = lock_feedback_required()
        if STATE.package_request_id and STATE.package_request_id in PACKAGE_REQUESTS:
            pkg = PACKAGE_REQUESTS[STATE.package_request_id]
            payload["estimated_arrival"] = pkg.requested_slot or ""
            payload["package_label"] = pkg.package_label or ""
        else:
            payload["estimated_arrival"] = ""
            payload["package_label"] = ""
        payload.pop("task_pin_hash", None)
        payload.pop("unlock_pin_plain", None)
        payload.pop("tracking_token", None)
        payload.pop("tracking_url", None)
        payload.pop("recipient_email", None)

        latency_ms = int((time.time() - t0) * 1000)
        logger.log("API_LATENCY", f"endpoint=/status latency_ms={latency_ms}")

        return jsonify(payload)


def create_delivery_task(dest: str, drawer: str, recipient_id: str, recipient_email: str, package_request_id: str = ""):
    t0 = time.time()
    drawer = (drawer or "D1").strip().upper()
    dest = (dest or "").strip()
    recipient_id = (recipient_id or "demo_user").strip()
    recipient_email = (recipient_email or "").strip()
    pin = generate_unlock_pin()

    if dest not in DESTINATION_CHOICES:
        logger.log("TASK_CREATE_BLOCKED", f"destination_invalid destination={dest!r}")
        return {
            "ok": False,
            "error": "DESTINATION_INVALID",
            "destinations": list(DESTINATION_CHOICES),
        }, 400

    if drawer not in config.DRAWER_IDS:
        logger.log("TASK_CREATE_BLOCKED", f"drawer_not_mapped drawer={drawer}")
        return {"ok": False, "error": "DRAWER_NOT_MAPPED"}, 400

    if not valid_email(recipient_email):
        logger.log(
            "TASK_CREATE_BLOCKED",
            "recipient_email_invalid",
        )
        return {
            "ok": False,
            "error": "RECIPIENT_EMAIL_REQUIRED",
        }, 400

    with PENDING_NAV_CANCELS_LOCK:
        if PENDING_NAV_CANCELS:
            logger.log(
                "TASK_CREATE_BLOCKED",
                "previous_navigation_cancel_pending",
            )
            return {
                "ok": False,
                "error": "NAV_CANCEL_PENDING",
            }, 503

    refresh_from_adapters()

    if lock_feedback_required():
        physical_lock_state = gpio.read_lock_state(drawer)
        if physical_lock_state in ["LOCKED", "UNLOCKED"]:
            STATE.lock_state = physical_lock_state

        if physical_lock_state != "LOCKED":
            logger.log(
                "TASK_CREATE_BLOCKED",
                (
                    f"drawer_not_locked drawer={drawer} "
                    f"lock_state={physical_lock_state}"
                ),
            )
            return {
                "ok": False,
                "error": "DRAWER_NOT_LOCKED",
                "lock_state": physical_lock_state,
                "message": (
                    "Close and secure the drawer before dispatching. "
                    "The lock sensor must report LOCKED."
                ),
            }, 409

    if battery_is_low_for_new_tasks():
        logger.log("TASK_CREATE_BLOCKED", f"battery_low percent={STATE.battery_percent}")
        return {"ok": False, "error": "BATTERY_LOW"}, 403

    if STATE.active_task_id is not None:
        logger.log("TASK_CREATE_BLOCKED", "task_already_active")
        return {"ok": False, "error": "TASK_ALREADY_ACTIVE"}, 400

    if STATE.fault:
        logger.log("TASK_CREATE_BLOCKED", "fault_active")
        return {"ok": False, "error": "FAULT_ACTIVE"}, 400

    STATE.active_task_id = f"T{int(time.time())}"
    STATE.drawer_id = drawer
    STATE.destination = dest
    STATE.recipient_id = recipient_id
    STATE.recipient_email = recipient_email
    STATE.package_request_id = package_request_id
    STATE.tracking_token = generate_tracking_token()
    STATE.tracking_url = tracking_url_for(STATE.tracking_token)
    STATE.task_pin_hash = hash_pin(pin)
    STATE.unlock_pin_plain = pin

    if gpio.is_drawer_unlocked(drawer):
        gpio.lock_drawer(drawer)
        logger.log("TASK_CREATE_LOCK", f"drawer={drawer} locked_before_uart")
    ensure_uart_started()

    STATE.task_state = "TASK_ACTIVE"
    STATE.nav_status = "TASK_SENT"
    STATE.last_nav_msg_time = None
    STATE.route_recovery_count = 0
    STATE.recovery_limit = 10

    STATE.abort_reason = ""
    STATE.abort_x = None
    STATE.abort_y = None
    STATE.abort_yaw = None
    STATE.abort_notification = False

    motion.moving = False
    motion.arrived = False
    motion.fault = False

    STATE.auth_required = False
    STATE.auth_ok = False
    STATE.failed_attempts = 0
    STATE.lockout_until = None
    STATE.tracking_email_sent = False
    STATE.unlock_email_sent = False
    STATE.lock_state = "LOCKED"
    STATE.unlock_pulse_sent = False
    STATE.lock_unlocked_confirmed = False

    STATE.drawer_prompt = "Task created. On-the-way email sent. Unlock code will be emailed on arrival."
    STATE.comm_ok = True

    sent = True
    send_error = ""
    if getattr(config, "NAV_BRIDGE_ENABLED", False):
        sent = send_task_to_nav_bridge(
            STATE.active_task_id,
            STATE.destination,
            STATE.drawer_id,
            mission_type="delivery",
        )
        if not sent:
            send_error = "NAV_BRIDGE_SEND_FAILED"
    elif uart:
        sent = False
        for _ in range(3):
            sent = uart.send_task_create(STATE.active_task_id, STATE.destination, STATE.drawer_id)
            if sent:
                break
            time.sleep(0.2)
        if not sent:
            send_error = "UART_SEND_FAILED"

    if not sent:
        logger.log("TASK_CREATE_FAIL", f"id={STATE.active_task_id} error={send_error}")
        reset_to_idle_after_complete("Failed to send task to navigation system.")
        return {"ok": False, "error": send_error}, 500

    motion.moving = True
    voice.announce("DISPATCHED", STATE.active_task_id)
    tracking_email = send_tracking_email()

    logger.log(
        "TASK_CREATE_SENT",
        f"id={STATE.active_task_id} dest={dest} drawer={drawer} recipient={recipient_id} email={recipient_email} package_request={package_request_id}"
    )

    latency_ms = int((time.time() - t0) * 1000)
    logger.log("API_LATENCY", f"endpoint=create_delivery_task latency_ms={latency_ms}")

    return {
        "ok": True,
        "ack": "TASK_CREATED",
        "task_id": STATE.active_task_id,
        "tracking_url": STATE.tracking_url,
        "tracking_email": tracking_email
    }, 200


