def handle_ready_for_loading():
    """
    Loading flow for a spring solenoid lock:
    - GPIO stays low unless a user requests a short unlock pulse.
    - Staff pulse-unlocks the drawer from admin, loads the package, closes it.
    - Task creation requires the drawer to be closed before dispatch.
    """
    if STATE.task_state != "READY_FOR_LOADING":
        return

    STATE.drawer_prompt = "Ready. Pulse unlock only when loading, then close the drawer before dispatch."


def next_day_slots() -> list:
    slot_date = (now() + timedelta(days=1)).date().isoformat()
    windows = [
        "09:00-10:00",
        "10:00-11:00",
        "11:00-12:00",
        "13:00-14:00",
        "14:00-15:00",
        "15:00-16:00",
    ]
    return [f"{slot_date} {window}" for window in windows]


def slot_start_time(slot: str):
    try:
        date_part, window = slot.split(" ", 1)
        start_part = window.split("-", 1)[0]
        return datetime.fromisoformat(f"{date_part}T{start_part}:00")
    except Exception:
        return None


def cancel_deadline_for_slot(slot: str):
    start = slot_start_time(slot)
    if not start:
        return None
    return start - timedelta(hours=getattr(config, "CANCEL_CUTOFF_HOURS", 6))


def can_cancel_request(req: PackageRequest) -> bool:
    if req.status != "SCHEDULED" or not req.requested_slot:
        return False

    deadline = cancel_deadline_for_slot(req.requested_slot)
    if not deadline:
        return False

    return now() <= deadline


def dispatch_ready_time_for_slot(slot: str):
    start = slot_start_time(slot)
    if not start:
        return None
    return start - timedelta(minutes=getattr(config, "DISPATCH_LEAD_MINUTES", 15))


def can_dispatch_request(req: PackageRequest) -> tuple:
    if req.status != "SCHEDULED" or not req.requested_slot:
        return False, "REQUEST_NOT_READY"

    if not getattr(config, "ENFORCE_DELIVERY_WINDOW", False):
        return True, "DEMO_EARLY_DISPATCH_ALLOWED"

    ready_at = dispatch_ready_time_for_slot(req.requested_slot)
    if not ready_at:
        return False, "REQUEST_TIME_INVALID"

    if now() < ready_at:
        return False, "DELIVERY_WINDOW_NOT_READY"

    return True, "DELIVERY_WINDOW_READY"


def available_slots() -> list:
    used = {
        req.requested_slot
        for req in PACKAGE_REQUESTS.values()
        if req.requested_slot
        and req.status in {"SCHEDULED", *ACTIVE_PACKAGE_STATUSES}
    }
    return [slot for slot in next_day_slots() if slot not in used]


def find_package_request_by_token(token: str):
    for req in PACKAGE_REQUESTS.values():
        if hmac.compare_digest(req.token, token):
            return req
    return None


def serialize_package_request(req: PackageRequest) -> dict:
    cancel_deadline = cancel_deadline_for_slot(req.requested_slot)
    dispatch_ready_at = dispatch_ready_time_for_slot(req.requested_slot)
    can_dispatch, dispatch_reason = can_dispatch_request(req)
    return {
        "request_id": req.request_id,
        "token": req.token,
        "recipient_name": req.recipient_name,
        "recipient_email": req.recipient_email,
        "package_label": req.package_label,
        "destination": req.destination,
        "requested_slot": req.requested_slot,
        "status": req.status,
        "dispatch_task_id": req.dispatch_task_id,
        "created_at": req.created_at.isoformat(timespec="seconds") if req.created_at else None,
        "scheduled_at": req.scheduled_at.isoformat(timespec="seconds") if req.scheduled_at else None,
        "dispatched_at": req.dispatched_at.isoformat(timespec="seconds") if req.dispatched_at else None,
        "cancel_deadline": cancel_deadline.isoformat(timespec="seconds") if cancel_deadline else None,
        "can_cancel": can_cancel_request(req),
        "dispatch_ready_at": dispatch_ready_at.isoformat(timespec="seconds") if dispatch_ready_at else None,
        "can_dispatch": can_dispatch,
        "dispatch_reason": dispatch_reason,
    }


