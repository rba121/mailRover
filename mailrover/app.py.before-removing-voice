    with STATE_LOCK:
        t0 = time.time()

        if STATE.active_task_id and uart:
            sent = uart.send_task_cancel(STATE.active_task_id)
            if not sent:
                logger.log("TASK_CANCEL_FAIL", f"id={STATE.active_task_id} uart_send_failed")
                return jsonify({"ok": False, "error": "UART_SEND_FAILED"}), 500

        if STATE.drawer_id in ["D1", "D2", "D3", "D4"]:
            gpio.lock_drawer(STATE.drawer_id)

        if STATE.package_request_id in PACKAGE_REQUESTS:
            PACKAGE_REQUESTS[STATE.package_request_id].status = "CANCELED"
            save_package_request(PACKAGE_REQUESTS[STATE.package_request_id])

        logger.log("TASK_CANCEL", f"id={STATE.active_task_id}")

        motion.moving = False
        motion.arrived = False
        motion.fault = False

        reset_to_idle_after_complete("Task canceled. Ready for loading again.")

        latency_ms = int((time.time() - t0) * 1000)
        logger.log("API_LATENCY", f"endpoint=/task/cancel latency_ms={latency_ms}")
        return jsonify({"ok": True, "ack": "TASK_CANCELED"})


