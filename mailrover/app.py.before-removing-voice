            }), 403

        req.status = "COMPLETED"
        save_package_request(req)
        serialized = serialize_package_request(req)

    logger.log(
        "STALE_PACKAGE_HOME_CONFIRMED",
        f"request={request_id}",
    )
    return jsonify({
        "ok": True,
        "ack": "HOME_CONFIRMED_REQUEST_COMPLETED",
