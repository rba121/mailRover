def now():
    return datetime.now()


def parse_datetime(value: str):
    if not value:
        return None
    return datetime.fromisoformat(value)


def package_db_connect():
    db_dir = os.path.dirname(config.PACKAGE_DB_PATH)
    if db_dir:
        os.makedirs(db_dir, exist_ok=True)
    conn = sqlite3.connect(config.PACKAGE_DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def init_package_db():
    with package_db_connect() as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS package_requests (
                request_id TEXT PRIMARY KEY,
                token TEXT NOT NULL UNIQUE,
                recipient_name TEXT NOT NULL,
                recipient_email TEXT NOT NULL,
                package_label TEXT NOT NULL DEFAULT '',
                destination TEXT NOT NULL DEFAULT '',
                requested_slot TEXT NOT NULL DEFAULT '',
                status TEXT NOT NULL,
                dispatch_task_id TEXT NOT NULL DEFAULT '',
                created_at TEXT,
                scheduled_at TEXT,
                dispatched_at TEXT
            )
            """
        )
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS app_settings (
                setting_key TEXT PRIMARY KEY,
                setting_value TEXT NOT NULL
            )
            """
        )


def persist_battery_reading(percent: int, voltage_mv=None):
    with package_db_connect() as conn:
        conn.execute(
            """
            INSERT INTO app_settings (setting_key, setting_value)
            VALUES ('battery_percent', ?)
            ON CONFLICT(setting_key) DO UPDATE SET
                setting_value=excluded.setting_value
            """,
            (str(percent),),
        )
        if voltage_mv is not None:
            conn.execute(
                """
                INSERT INTO app_settings (setting_key, setting_value)
                VALUES ('battery_voltage_mv', ?)
                ON CONFLICT(setting_key) DO UPDATE SET
                    setting_value=excluded.setting_value
                """,
                (str(voltage_mv),),
            )


def load_persistent_battery_state():
    global BATTERY_LAST_PERSISTED_PERCENT
    global BATTERY_LAST_PERSISTED_VOLTAGE_MV

    init_package_db()
    with package_db_connect() as conn:
        percent_row = conn.execute(
            """
            SELECT setting_value
            FROM app_settings
            WHERE setting_key = 'battery_percent'
            """
        ).fetchone()
        voltage_row = conn.execute(
            """
            SELECT setting_value
            FROM app_settings
            WHERE setting_key = 'battery_voltage_mv'
            """
        ).fetchone()

    saved_percent = STATE.battery_percent
    if percent_row is not None:
        try:
            saved_percent = max(
                0,
                min(100, int(percent_row["setting_value"])),
            )
        except (TypeError, ValueError):
            logger.log(
                "BATTERY_STATE_INVALID",
                (
                    f"value={percent_row['setting_value']!r}; "
                    f"resetting={saved_percent}"
                ),
            )

    saved_voltage_mv = None
    if voltage_row is not None:
        try:
            saved_voltage_mv = int(voltage_row["setting_value"])
        except (TypeError, ValueError):
            saved_voltage_mv = None

    STATE.battery_percent = saved_percent
    STATE.battery_voltage_mv = saved_voltage_mv
    STATE.battery_adc_ok = False
    STATE.battery_reading_source = "SAVED"
    BATTERY_LAST_PERSISTED_PERCENT = saved_percent
    BATTERY_LAST_PERSISTED_VOLTAGE_MV = saved_voltage_mv
    persist_battery_reading(saved_percent, saved_voltage_mv)
    logger.log(
        "BATTERY_STATE_LOADED",
        f"percent={saved_percent} voltage_mv={saved_voltage_mv}",
    )


def row_to_package_request(row) -> PackageRequest:
    return PackageRequest(
        request_id=row["request_id"],
        token=row["token"],
        recipient_name=row["recipient_name"],
        recipient_email=row["recipient_email"],
        package_label=row["package_label"],
        destination=row["destination"],
        requested_slot=row["requested_slot"],
        status=row["status"],
        dispatch_task_id=row["dispatch_task_id"],
        created_at=parse_datetime(row["created_at"]),
        scheduled_at=parse_datetime(row["scheduled_at"]),
        dispatched_at=parse_datetime(row["dispatched_at"]),
    )


def load_package_requests():
    init_package_db()
    with package_db_connect() as conn:
        rows = conn.execute("SELECT * FROM package_requests").fetchall()

    PACKAGE_REQUESTS.clear()
    for row in rows:
        req = row_to_package_request(row)
        PACKAGE_REQUESTS[req.request_id] = req

    logger.log("PACKAGE_DB_LOADED", f"count={len(PACKAGE_REQUESTS)} path={config.PACKAGE_DB_PATH}")


def clear_pending_package_requests_on_startup():
    if not getattr(config, "CLEAR_PENDING_ON_STARTUP", False):
        return

    init_package_db()
    with package_db_connect() as conn:
        result = conn.execute(
            """
            UPDATE package_requests
            SET status = 'ABORTED'
            WHERE status IN ('DISPATCHED', 'ARRIVED', 'RETURNING')
            """
        )

    logger.log(
        "PACKAGE_DB_INTERRUPTED_RECONCILED",
        f"count={result.rowcount}",
    )


def save_package_request(req: PackageRequest):
    init_package_db()
    with package_db_connect() as conn:
        conn.execute(
            """
            INSERT INTO package_requests (
                request_id,
                token,
                recipient_name,
                recipient_email,
                package_label,
                destination,
                requested_slot,
                status,
                dispatch_task_id,
                created_at,
                scheduled_at,
                dispatched_at
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(request_id) DO UPDATE SET
                token=excluded.token,
                recipient_name=excluded.recipient_name,
                recipient_email=excluded.recipient_email,
                package_label=excluded.package_label,
                destination=excluded.destination,
                requested_slot=excluded.requested_slot,
                status=excluded.status,
                dispatch_task_id=excluded.dispatch_task_id,
                created_at=excluded.created_at,
                scheduled_at=excluded.scheduled_at,
                dispatched_at=excluded.dispatched_at
            """,
            (
                req.request_id,
                req.token,
                req.recipient_name,
                req.recipient_email,
                req.package_label,
                req.destination,
                req.requested_slot,
                req.status,
                req.dispatch_task_id,
                req.created_at.isoformat(timespec="seconds") if req.created_at else None,
                req.scheduled_at.isoformat(timespec="seconds") if req.scheduled_at else None,
                req.dispatched_at.isoformat(timespec="seconds") if req.dispatched_at else None,
            ),
        )


def update_active_package_status(status: str):
    """Persist the package status that belongs to the active robot task."""
    package_request = PACKAGE_REQUESTS.get(STATE.package_request_id)
    if not package_request:
        return None

    package_request.status = status
    save_package_request(package_request)
    return package_request


def reconcile_orphaned_active_package_requests() -> int:
    """Fail stale delivery records closed when no matching live task exists."""
    live_request_id = (
        STATE.package_request_id
        if STATE.active_task_id and STATE.package_request_id
        else ""
    )
    stale_requests = [
        req
        for req in PACKAGE_REQUESTS.values()
        if req.status in ACTIVE_PACKAGE_STATUSES
        and req.request_id != live_request_id
    ]

    if not stale_requests:
        return 0

    with package_db_connect() as conn:
        conn.executemany(
            """
            UPDATE package_requests
            SET status = 'ABORTED'
            WHERE request_id = ?
            """,
            [(req.request_id,) for req in stale_requests],
        )

    for req in stale_requests:
        req.status = "ABORTED"

    logger.log(
        "PACKAGE_DB_ORPHANED_ACTIVE_RECONCILED",
        (
            f"count={len(stale_requests)} "
            f"requests={','.join(req.request_id for req in stale_requests)}"
        ),
    )
    return len(stale_requests)


clear_pending_package_requests_on_startup()
