            timeout=getattr(config, "NAV_BRIDGE_TIMEOUT_SEC", 2.0),
        ) as response:
            ok = 200 <= response.status < 300
            logger.log(
                "NAV_BRIDGE_CANCEL_RETURN_HOME",
                f"task={task_id} drawer={drawer_id} ok={ok}",
